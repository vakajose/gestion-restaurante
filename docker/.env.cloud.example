# ==============================================================================
# Variables de Entorno Cloud / Staging / Testing-Local (ADR-0026 / Twelve-Factor)
# Copiar como .env en el host destino (nunca versionar secretos reales en Git)
# ==============================================================================

# --- Imagenes Registry (GHCR) ---
GHCR_OWNER=changeme-github-owner
IMAGE_TAG=latest

# --- Dominios & TLS (Caddy) ---
ACME_EMAIL=ops@restaurante.example.com
APP_DOMAIN=app.restaurante.example.com
ADMIN_DOMAIN=admin.restaurante.example.com
API_DOMAIN=api.restaurante.example.com
LOGS_DOMAIN=logs.restaurante.example.com

# --- Dominios & Basic Auth Staging On-Demand ---
STAGING_APP_DOMAIN=staging-app.restaurante.example.com
STAGING_ADMIN_DOMAIN=staging-admin.restaurante.example.com
STAGING_API_DOMAIN=staging-api.restaurante.example.com
STAGING_BASIC_AUTH_USER=qa
STAGING_BASIC_AUTH_HASH=$2a$14$REEMPLAZAR_CON_CADDY_HASH_PASSWORD

# --- Visor Logs Dozzle (generar hash con: docker run --rm caddy:2.9-alpine caddy hash-password) ---
DOZZLE_ADMIN_USER=opsadmin
DOZZLE_ADMIN_PASSWORD_HASH=$2a$14$REEMPLAZAR_CON_CADDY_HASH_PASSWORD

# --- Base de Datos Separada (VM 2 OCI VCN IP Privada) ---
DB_PRIVATE_HOST=10.0.1.20
DB_PORT=5432
PROD_DB_NAME=restaurant_prod
PROD_DB_USER=app_prod
PROD_DB_PASSWORD=REEMPLAZAR_PASSWORD_PROD_FUERTE
STAGING_DB_NAME=restaurant_staging
STAGING_DB_USER=app_staging
STAGING_DB_PASSWORD=REEMPLAZAR_PASSWORD_STAGING_FUERTE

# --- Seguridad JWT (min. 32 bytes aleatorios: openssl rand -base64 48) ---
JWT_SECRET=REEMPLAZAR_CON_SECRETO_TENANT_MIN_32_CHARS
PLATFORM_JWT_SECRET=REEMPLAZAR_CON_SECRETO_PLATFORM_DISTINTO_MIN_32_CHARS
JWT_EXPIRATION_SECONDS=900
PLATFORM_JWT_EXPIRATION_SECONDS=900

# --- Bootstrap SuperAdmin (Break-Glass / Arranque inicial) ---
PLATFORM_ADMIN_USERNAME=superadmin
PLATFORM_ADMIN_EMAIL=superadmin@restaurante.example.com
PLATFORM_ADMIN_PASSWORD=REEMPLAZAR_PASSWORD_BOOTSTRAP_12_CHARS

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://app.restaurante.example.com,https://admin.restaurante.example.com
STAGING_CORS_ALLOWED_ORIGINS=https://staging-app.restaurante.example.com,https://staging-admin.restaurante.example.com

# --- Object Storage (OCI Object Storage S3-Compatible) ---
APP_STORAGE_TYPE=S3
S3_ENDPOINT=https://REEMPLAZAR_NAMESPACE.compat.objectstorage.us-ashburn-1.oraclecloud.com
S3_REGION=us-ashburn-1
S3_BUCKET=restaurant-media-prod
S3_ACCESS_KEY=REEMPLAZAR_OCI_CUSTOMER_SECRET_ACCESS_KEY
S3_SECRET_KEY=REEMPLAZAR_OCI_CUSTOMER_SECRET_KEY
S3_PATH_STYLE_ACCESS=true
S3_PUBLIC_BASE_URL=https://REEMPLAZAR_NAMESPACE.compat.objectstorage.us-ashburn-1.oraclecloud.com/restaurant-media-prod

# --- Backups Automatizados PostgreSQL -> OCI Object Storage ---
BACKUP_S3_BUCKET=restaurant-db-backups
BACKUP_ENCRYPTION_PASSPHRASE=REEMPLAZAR_PASSPHRASE_GPG_AES256_LARGA
BACKUP_RETENTION_DAYS=14
