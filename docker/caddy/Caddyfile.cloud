{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
	reverse_proxy backend:8080
}

{$APP_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy erp-frontend:8080
}

{$ADMIN_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy backoffice-frontend:8080
}

{$LOGS_DOMAIN} {
	encode zstd gzip
	basic_auth {
		{$DOZZLE_ADMIN_USER} {$DOZZLE_ADMIN_PASSWORD_HASH}
	}
	reverse_proxy dozzle:8080
}

import /etc/caddy/conf.d/*.caddy
