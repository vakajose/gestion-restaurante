# ==============================================================================
# Plantilla Twelve-Factor de Variables de Entorno - Restaurant POS ERP
# Copiar como .env (desarrollo local) o inyectar vía Docker/CI-CD en nube.
# NUNCA commitear archivos .env reales con secretos.
# ==============================================================================

# Perfil Spring activo: dev | testing-local | staging | prod
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# PostgreSQL (en staging/prod apunta a la IP privada de VM 2)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/restaurant_dev
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me_strong_password

# Seguridad JWT (mínimo 32 caracteres aleatorios en testing-local/staging/prod)
JWT_SECRET=replace_with_at_least_32_chars_random_secret_key
JWT_EXPIRATION_SECONDS=900
# Opcional: secreto JWT independiente para el módulo Backoffice (por defecto usa JWT_SECRET)
PLATFORM_JWT_SECRET=replace_with_independent_32_chars_platform_secret
PLATFORM_JWT_EXPIRATION_SECONDS=900

# Bootstrap Inicial de Plataforma (obligatorio en primer arranque limpio de testing-local/staging/prod; min 12 chars)
PLATFORM_ADMIN_USERNAME=superadmin
PLATFORM_ADMIN_EMAIL=admin@platform.example.com
PLATFORM_ADMIN_PASSWORD=replace_with_strong_12plus_char_password
PLATFORM_ADMIN_FULL_NAME=Platform Superadmin

# Orígenes CORS permitidos separados por coma (sin wildcard * en staging/prod)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# Storage (LOCAL en dev; S3 en testing-local MinIO / staging / prod OCI Object Storage)
APP_STORAGE_TYPE=LOCAL
APP_STORAGE_LOCAL_PATH=./uploads/dishes/
APP_STORAGE_PUBLIC_URL_PREFIX=/uploads/dishes/

# Credenciales S3-Compatible (OCI Object Storage: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com)
S3_ENDPOINT=
S3_REGION=us-ashburn-1
S3_BUCKET=restaurant-media-public
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE_ACCESS=true
S3_PUBLIC_BASE_URL=
