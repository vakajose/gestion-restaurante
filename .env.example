# ==============================================================================
# Plantilla Twelve-Factor de Variables de Entorno - Restaurant POS ERP
# Copiar como .env (desarrollo local) o inyectar vía Docker/CI-CD en nube.
# NUNCA commitear archivos .env reales con secretos.
# ==============================================================================

# Perfil Spring activo: dev | testing-local | staging | prod
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# PostgreSQL (en staging/prod apunta a la IP privada de VM 2)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/restaurant_dev
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me_strong_password

# Seguridad JWT (mínimo 32 caracteres aleatorios en testing-local/staging/prod)
JWT_SECRET=replace_with_at_least_32_chars_random_secret_key
JWT_EXPIRATION_SECONDS=900

# Orígenes CORS permitidos separados por coma (sin wildcard * en staging/prod)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# Storage (local en dev; s3/oci en TASK-603)
APP_STORAGE_TYPE=local
APP_STORAGE_LOCAL_PATH=./uploads/dishes/
APP_STORAGE_PUBLIC_URL_PREFIX=/uploads/dishes/
